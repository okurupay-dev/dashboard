# Supabase Authentication (replaces Clerk)
# Get these from your Supabase project settings

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # For server-side operations

# Web3Auth Configuration
REACT_APP_WEB3AUTH_CLIENT_ID=your_web3auth_client_id_here

# Optional: Custom API endpoints (if using external APIs)
REACT_APP_API_BASE_URL=https://api.okurupay.com
REACT_APP_API_TOKEN=your_api_token_here

# Development Mode (set to 'true' for local development)
REACT_APP_DEV_MODE=true
